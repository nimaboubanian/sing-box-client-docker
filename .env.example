# Required: BPB panel subscription URL (must serve sing-box JSON with urltest groups)
SUB_URL=

# sing-box log level (debug|info|warn|error)
LOG_LEVEL=warn

# Optional: urltest group tag to use for the tunnel (default: first in sub)
# Candidates in a BPB sub: "💦 🔗 Best Ping 🚀", "💦 🔗 Best Ping D 🚀" (chained),
# "💦 Best Ping 🚀", "💦 Best Ping D 🚀" (direct)
FINAL_TAG=

# Optional: scheduled tunnel refresh in seconds — re-fetch the sub, then swap
# sing-box only if fetch+render succeeded (a failed refresh never kills a
# healthy tunnel). Disabled while commented out (or 0).
# RESTART_INTERVAL=600

# External Docker network name (must match the softether project's network)
VPN_NET_NAME=softether-client-docker_vpn-net
